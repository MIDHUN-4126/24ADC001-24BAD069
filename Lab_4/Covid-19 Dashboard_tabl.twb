      <column caption='Case Fatality Rate' datatype='real' name='[Calculation_0829060609458176]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [total_cases] &gt; 0 THEN&#13;&#10;([total_deaths]/[total_cases])*100&#13;&#10;END' />
      </column>
      <column caption='Vaccination %' datatype='real' name='[Calculation_0829060609646593]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [population] &gt; 0 THEN&#13;&#10;([people_vaccinated]/[population])*100&#13;&#10;END' />
      </column>
      <column caption='Daily Case Growth Rate' datatype='real' name='[Calculation_0829060609798146]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [total_cases] &gt; 0 THEN&#13;&#10;([new_cases]/[total_cases])*100&#13;&#10;END' />
      </column>

      <column caption='Profit Margin %' datatype='real' name='[Calculation_0119875593736192]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Profit]/[Sales])*100' />
      </column>
      <column caption='Sales Growth %' datatype='real' name='[Calculation_0119875593924609]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Sales])-LOOKUP(SUM([Sales]),-1))&#13;&#10;/&#13;&#10;LOOKUP(SUM([Sales]),-1)&#13;&#10;*100'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='YTD Sales' datatype='real' name='[Calculation_0119875594080258]' role='measure' type='quantitative'>

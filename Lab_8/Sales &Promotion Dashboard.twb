      <aliases enabled='yes' />
      <column caption='Sales Growth %' datatype='real' name='[Calculation_0399983637688320]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([sales]) - LOOKUP(SUM([sales]), -1))&#13;&#10;/&#13;&#10;ABS(LOOKUP(SUM([sales]), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Promotion Duration' datatype='integer' name='[Calculation_0399983639162881]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Promotion Start Date], [Promotion End Date])' />
      </column>
      <column caption='Expected Growth %' datatype='real' name='[Calculation_0399983641022466]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;    (&#13;&#10;        { FIXED : SUM([sales]) } * 1.10&#13;&#10;    )&#13;&#10;    -&#13;&#10;    { FIXED : SUM([sales]) }&#13;&#10;)&#13;&#10;/&#13;&#10;{ FIXED : SUM([sales]) }&#13;&#10;* 100' />
      </column>
      <column caption='Forecasted Sales' datatype='real' name='[Calculation_0399983641845763]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : SUM([sales]) } * 1.10' />
      </column>

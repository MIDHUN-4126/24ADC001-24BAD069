      <aliases enabled='yes' />
      <column caption='Null Region' datatype='string' name='[Calculation_0356268130590720]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([Region], &quot;Unknown&quot;)' />
      </column>
      <column caption='Zero sales' datatype='real' name='[Calculation_0356268131823617]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Sales], 0)' />
      </column>
      <column caption='Capping Sales' datatype='string' name='[Calculation_0356268132290562]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM(Sales) &gt; 10000 THEN &quot;Outlier&quot; ELSE &quot;Normal&quot; END' />
      </column>
      <column caption='Flag outliers' datatype='string' name='[Calculation_0356268137512963]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Sales]) &gt; 300000 OR SUM([Profit]) &gt; 50000 OR SUM([Profit]) &lt; -20000 THEN &#13;&#10;    &quot;Outlier&quot; &#13;&#10;ELSE &#13;&#10;    &quot;Normal&quot; &#13;&#10;END' />
      </column>
      <column caption='Profit Ratio' datatype='real' name='[Calculation_1368249927221915648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit])/SUM([Sales])' />
      </column>
